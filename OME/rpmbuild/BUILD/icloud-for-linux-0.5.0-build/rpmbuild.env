
  RPM_SOURCE_DIR="OME/rpmbuild/SOURCES"
  RPM_BUILD_DIR="OME/rpmbuild/BUILD/icloud-for-linux-0.5.0-build"
  RPM_OPT_FLAGS="-O2 -g"
  RPM_LD_FLAGS=""
  RPM_ARCH="x86_64"
  RPM_OS="linux"
  RPM_BUILD_NCPUS="32"
  RPM_SPECPARTS_DIR="OME/rpmbuild/BUILD/icloud-for-linux-0.5.0-build/SPECPARTS"
  export RPM_SOURCE_DIR RPM_BUILD_DIR RPM_OPT_FLAGS RPM_ARCH RPM_OS RPM_BUILD_NCPUS RPM_SPECPARTS_DIR RPM_LD_FLAGS
  RPM_DOC_DIR="/usr/share/doc"
  export RPM_DOC_DIR
  RPM_PACKAGE_NAME="icloud-for-linux"
  RPM_PACKAGE_VERSION="0.5.0"
  RPM_PACKAGE_RELEASE="1"
  export RPM_PACKAGE_NAME RPM_PACKAGE_VERSION RPM_PACKAGE_RELEASE
  LANG=C.UTF-8
  export LANG
  unset CDPATH DISPLAY ||:
  unset DEBUGINFOD_URLS ||:
  unset RPM_CONFIG_DIR ||:
  RPM_BUILD_ROOT="OME/rpmbuild/BUILD/icloud-for-linux-0.5.0-build/BUILDROOT"
  export RPM_BUILD_ROOT
  
  PKG_CONFIG_PATH="${PKG_CONFIG_PATH}:/usr/lib64/pkgconfig:/usr/share/pkgconfig"
  export PKG_CONFIG_PATH
