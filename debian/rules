#!/usr/bin/make -f
# Build the Debian package.
#
# The binary is built with cargo, so the Rust toolchain has to be installed;
# the build dependencies in debian/control take care of that.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = $(CURDIR)/debian/cargo
# The build directory of cargo stays inside the source tree, so the package
# does not depend on a cargo configuration of the build machine.
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	# The completions are shipped with the package.
	cargo build --release --locked --features completions

override_dh_auto_test:
	# The tests need a FUSE device, which is not available while the package
	# is built. They run in the continuous integration instead.
	cargo test --release --locked --no-run

override_dh_auto_install:
	install -Dm755 $(CARGO_TARGET_DIR)/release/icloudctl \
		debian/icloud-for-linux/usr/bin/icloudctl
	install -Dm644 docs/icloudctl.1 debian/icloud-for-linux/usr/share/man/man1/icloudctl.1
	install -Dm644 config.example.yaml \
		debian/icloud-for-linux/etc/icloud-for-linux/config.yaml.example
	install -Dm644 packaging/systemd/icloud-for-linux.service \
		debian/icloud-for-linux/lib/systemd/user/icloud-for-linux.service
	# The completion script is generated from the command line definition.
	mkdir -p debian/icloud-for-linux/usr/share/bash-completion/completions
	$(CARGO_TARGET_DIR)/release/icloudctl-completions bash \
		> debian/icloud-for-linux/usr/share/bash-completion/completions/icloudctl

override_dh_auto_clean:
	cargo clean
	rm -rf debian/cargo debian/icloud-for-linux debian/.debhelper debian/files
	rm -f debian/icloud-for-linux.substvars
